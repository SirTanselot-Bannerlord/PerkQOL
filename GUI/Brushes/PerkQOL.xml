<Brushes>
  <Brush Name="PerkQOL.CaptainFlags.Button">
    <Layers>
      <!-- Dark warm brown to sit in the leather button; hover ColorFactor lifts it. -->
      <BrushLayer Name="Default" Sprite="SPGeneral\GameMenu\craft_icon" Color="#6B5C4AFF" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1.0" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.45" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.85" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.5" AlphaFactor="0.7" />
      </Style>
    </Styles>
  </Brush>
</Brushes>
