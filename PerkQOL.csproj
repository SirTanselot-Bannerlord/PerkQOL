  <Target Name="DeployToBannerlord" AfterTargets="Build" Condition="'$(SkipBannerlordDeploy)' != 'true'">
    <MakeDir Directories="$(BannerlordModuleDir)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BannerlordModuleDir)\bin\Win64_Shipping_Client" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(BannerlordModuleDir)\bin\Win64_Shipping_Client" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\SubModule.xml" DestinationFolder="$(BannerlordModuleDir)" SkipUnchangedFiles="false" />
